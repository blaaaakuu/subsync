{
  "name": "subsync-web",
  "version": "0.18.0-dev",
  "private": true,
  "description": "Subtitle Speech Synchronizer web client",
  "scripts": {
    "native:fetch": "node tools/fetch-native-deps.mjs",
    "native:build": "npm run native:fetch && docker build -t subsync-web-build . && docker run --rm -v $(pwd)/..:/src --user $(id -u):$(id -g) -w /src/web subsync-web-build emmake make -j4",
    "build": "browserify src/main.js -o scripts/subsync.js",
    "watch": "watchify src/main.js -o scripts/subsync.js -v -d",
    "gen-version": "sh -c \"echo '{\\\"version\\\":\\\"$(git describe --tags)\\\",\\\"hash\\\":\\\"$(git rev-parse HEAD)\\\"}'\" > version.json",
    "locale-validate": "node tools/validate-translations.mjs",
    "locale-validate-pl": "node tools/validate-translations.mjs src/translations/pl.json"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "sc0ty",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/sc0ty/subsync.git"
  },
  "dependencies": {
    "@babel/runtime": "7.28.4",
    "comlink": "4.4.2",
    "es2015-i18n-tag": "1.6.1",
    "js-cookie": "3.0.8",
    "jszip": "3.10.1",
    "redom": "4.1.5",
    "webworkify": "1.5.0"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.0",
    "@babel/plugin-transform-react-jsx": "7.25.9",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.0",
    "babel-plugin-transform-redom-jsx": "2.0.1",
    "babelify": "10.0.0",
    "browserify": "17.0.1",
    "watchify": "4.0.0"
  },
  "browserify": {
    "transform": [
      [
        "babelify",
        {
          "presets": [
            "@babel/preset-env"
          ],
          "plugins": [
            [
              "@babel/plugin-transform-runtime",
              {
                "regenerator": true
              }
            ],
            "babel-plugin-transform-redom-jsx",
            [
              "@babel/plugin-transform-react-jsx",
              {
                "pragma": "el"
              }
            ]
          ]
        }
      ]
    ]
  }
}
